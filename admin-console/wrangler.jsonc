{
  "name": "freightlogic-admin-console",
  "main": "worker.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
