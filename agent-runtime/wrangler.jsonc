{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "freightlogic-agent-v1",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "AGENT_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_STATE",
        "class_name": "FreightLogicAgentState"
      }
    ]
  },
  "exports": {
    "FreightLogicAgentState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
