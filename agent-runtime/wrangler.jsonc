{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "freightlogic-agent-v1",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "AGENT_ENABLED": "false",
    "AGENT_MODEL_SMALL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "AGENT_MODEL_STRONG": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "ai": {
    "binding": "AI"
  },
  "services": [
    {
      "binding": "ELI",
      "service": "freightlogic-eli-runtime-v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_STATE",
        "class_name": "FreightLogicAgentState"
      }
    ]
  },
  "exports": {
    "FreightLogicAgentState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
