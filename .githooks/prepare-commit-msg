#!/bin/sh
# Records which lock authorised a SHARED-path edit, as a commit trailer:
#   FL-Lock: <slug>/<token>
#
# Locks are released once work completes, so by the time CI runs on a PR the
# lock is legitimately gone. The trailer is what makes lock coverage auditable
# after the fact. CI checks the recorded owner, session token, covered path and valid claim at commit time.
#
# Merge messages are generated by Git; staged amendments still require current session authority.
case "$2" in merge) exit 0 ;; esac
node "$(git rev-parse --show-toplevel)/scripts/lane-guard.mjs" trailer >> "$1"
